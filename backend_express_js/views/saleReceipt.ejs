<!DOCTYPE html>
<html lang="en">

<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Receipt - Marwat Crockery</title>
    <style>
        body {
            font-family: Arial, sans-serif;
            width: 72mm;
            margin: 0;
            padding: 0;
        }

        .receipt {
            padding: 5px;
            box-sizing: border-box;
        }

        p {
            font-size: 12px;
            margin: 2px;
        }

        h3 {
            text-align: center;
            margin: 1px;
            padding-bottom: 5px;
            font-size: medium;
        }

        .right {
            text-align: right;
            padding-left: auto;
            margin-left: auto;
        }

        .left {
            text-align: left;
            padding-left: 1px;
        }

        .center {
            text-align: center;
        }

        table {
            border-bottom: 2px solid black;
            padding-bottom: 12px;
            margin-bottom: 12px;
        }
    </style>
    
    <script>
        // Auto-print the receipt when the page loads
        window.onload = function () {
            window.print();
            setTimeout(() => window.close(), 1000); // Close the window after printing
        };
    </script>
</head>

<body>
    <% let count = 0; dataSet.forEach(data => { count++; %>
        <div class="receipt">


<% if (count === 1) { %>
    <header style="text-align: center; width: 100%;">
        <img src="http://172.16.100.1:4000/companyLogo.png" alt="logo" style="height: 80px; margin-bottom: 8px;">
        <!-- <img src="http://localhost:4000/companyLogo.png" alt="logo" style="height: 80px; margin-bottom: 8px;"> -->
        <h3 style="margin-bottom: 2px; padding-bottom: 2px;">MARWAT CROCKERY <%= data.shopNumber %></h3>
        <p style="font-weight: bold; margin: 2px 0; padding: 0; line-height: 1;">Main Bazar Losar Sharfoo Opposite Wah Palace Marriage Hall, Wah Cantt</p>
    </header>
<% } else { %>
    <h3 style="margin-bottom: 2px; padding-bottom: 2px;">MARWAT CROCKERY <%= data.shopNumber %></h3>
<% } %>

<% if (count === 1) { %>    
            <table style="width: 72mm; margin-left: 1px; padding-left: 0%; display: block; border-collapse: collapse;">
                <tr>
                    <td style="width: 50%;">
                        <p style="margin: 2px 0; padding: 0; line-height: 1; font-size: 14px;">Ghulam Murtaza</p>
                    </td>
                    <td style="width: 50%; text-align: right;">
                        <p style="margin: 2px 0; padding: 0; line-height: 1; font-size: 14px;">03120876294</p>
                    </td>
                </tr>
                <tr>
                    <td style="width: 50%;">
                        <p style="margin: 2px 0; padding: 0; line-height: 1; font-size: 14px;">Easypaisa/Jazzcash</p>
                    </td>
                    <td style="width: 50%; text-align: right;">
                        <p style="margin: 2px 0; padding: 0; line-height: 1; font-size: 14px;">03225129030</p>
                    </td>
                </tr>
                <tr>
                    <td style="width: 50%;">
                        <p style="margin: 2px 0; padding: 0; line-height: 1; font-size: 14px;">Shop Number</p>
                    </td>
                    <td style="width: 50%; text-align: right;">
                        <p style="margin: 2px 0; padding: 0; line-height: 1; font-size: 14px;">03106666215</p>
                    </td>
                </tr>
                <tr>
                    <td style="width: 50%;">
                        <p style="margin: 2px 0; padding: 0; line-height: 1; font-size: 14px;">Receipt Number</p>
                    </td>
                    <td style="width: 50%; text-align: right;">
                        <p style="margin: 2px 0; padding: 0; line-height: 1; font-size: 14px;">
                            <%= data.receiptNumber %>
                        </p>
                    </td>
                </tr>
                <tr>
                    <td style="width: 50%;">
                        <p style="margin: 2px 0; padding: 0; line-height: 1; font-size: 14px;">Date & Time</p>
                    </td>
                    <td style="width: 50%; text-align: right;">
                        <p style="margin: 2px 0; padding: 0; line-height: 1; font-size: 14px;">
                            <%= data.dateandtime %>
                        </p>
                    </td>
                </tr>
                <tr>
                    <td style="width: 50%;">
                        <p style="margin: 2px 0; padding: 0; line-height: 1; font-size: 14px;">Operator</p>
                    </td>
                    <td style="width: 50%; text-align: right;">
                        <p style="margin: 2px 0; padding: 0; line-height: 1; font-size: 14px;">
                            <%= data.operator %>
                        </p>
                    </td>
                </tr>
                <tr>
                    <td style="width: 50%;">
                        <p style="margin: 2px 0; padding: 0; line-height: 1; font-size: 14px;">Rechecked By</p>
                    </td>
                    <td style="width: 50%; text-align: right;">
                        <p style="margin: 2px 0; padding: 0; line-height: 1; font-size: 14px;">_________________</p>
                    </td>
                </tr>
                
                <% if (data.customerName) { %>
                    <tr>
                        <td style="width: 50%;">
                            <p style="margin: 2px 0; padding: 0; line-height: 1; font-size: 14px;">Customer Name</p>
                        </td>
                        <td style="width: 50%; text-align: right;">
                            <p style="margin: 2px 0; padding: 0; line-height: 1; font-size: 14px;">
                                <%= data.customerName %>
                            </p>
                        </td>
                    </tr>
                <% } %>
            </table>
            
            <% } %>        
            <table style="width: 72mm; margin-left: 1px; padding-left: 0%; display: block; margin-bottom: 1px; border-collapse: collapse;">
                <tr style="background-color: black; color: white; font-size: 12px;">
                    <th style="text-align: left; width: 12%;">
                        <p style="margin: 2px 0; padding: 0;">Code</p>
                    </th>
                    <th style="text-align: left; width: 40%;">
                        <p style="margin: 2px 0; padding: 0;">Name</p>
                    </th>
                    <th style="width: 24%; text-align: center;">
                        <p style="margin: 2px 0; padding: 0;">Qty * Price</p>
                    </th>
                    <th style="width: 24%; text-align: right;">
                        <p style="margin: 2px 0; padding: 0;">Total</p>
                    </th>
                </tr>
                <% data.itemsList.forEach((item, index) => { %>
                    <% let rowStyle = index % 2 === 1 ? "font-weight: bold;" : ""; %>
                    <tr style="font-size: 12px; <%= rowStyle %>;">
                        <td style="width: 12%;">
                            <p style="margin: 2px 0; padding: 0;">
                                <%= item.product.itemCode %>
                            </p>
                        </td>
                        <td style="width: 40%;">
                            <p style="margin: 2px 0; padding: 0;">
                                <%= item.product.name %>
                            </p>
                        </td>
                        <td style="width: 24%; text-align: center;">
                            <p style="margin: 2px 0; padding: 0;">
                                <%= parseFloat(item.qty.toFixed(2)) %> x <%= parseFloat(item.finalprice.toFixed(2)) %>
                            </p>
                        </td>
                        <td style="width: 24%; text-align: right;">
                            <p style="margin: 2px 0; padding: 0;">
                                <%= parseFloat(item.saleamount.toFixed(2)) %>
                            </p>
                        </td>
                    </tr>
                <% }); %>
            </table>
            
            

            <table style="width: 72mm; margin-left: 1px; padding-left: 0%; display: block; border: none;">
                <tr>
                    <td style="width: 36mm; text-align: left;">
                        <p style="margin-bottom: 0;">Total Items</p>
                    </td>
                    <td style="width: 36mm; text-align: right;">
                        <p style="margin-bottom: 0;" class="right">
                            <%= data.totalItems.toFixed(2) %>
                        </p>
                    </td>
                </tr>
                <% if (data.discount !==0) { %>
                    <tr>
                        <td style="margin-bottom: 0;" class="left">
                            <p style="font-size: medium;">Subtotal</p>
                        </td>
                        <td>
                            <p class="right"
                                style="padding: 0; font-size: medium; margin-bottom: 0; font-weight: bold;">
                                <%= data.subTotal.toFixed(2) %>
                            </p>
                        </td>
                    </tr>
                    <tr>
                        <td class="left">
                            <p style="margin-bottom: 0; margin-top: 0;">Discount</p>
                        </td>
                        <td>
                            <p class="right" style="margin-top: 0; margin-bottom: 0;">
                                <%= data.discount.toFixed(2) %>
                            </p>
                        </td>
                    </tr>
                    <% } %>
                        <tr>
                            <td class="left">
                                <p style="font-size: medium; margin-top: 0; margin-bottom: 0;">Total Amount</p>
                            </td>
                            <td>
                                <p class="right"
                                    style="padding: 0; font-size: medium; font-weight: bold; margin-top: 0; margin-bottom: 0;">
                                    <%= data.totalAmount.toFixed(2) %>
                                </p>
                            </td>
                        </tr>

                        <% data.paymentsList.forEach(payment=> { %>
                            <tr>
                                <td>
                                    <p style="margin-top: 0; margin-bottom: 0;" class="left">
                                        <%= payment.name %>
                                    </p>
                                </td>
                                <td>
                                    <p class="right" style="margin-top: 0; margin-bottom: 0;">
                                        <%= payment.amount.toFixed(2) %>
                                    </p>
                                </td>
                            </tr>
                            <% }); %>


                                <tr>
                                    <td>
                                        <p class="left" style="font-size: medium; margin-top: 0; margin-bottom: 0;">
                                            Amount
                                            Paid</p>
                                    </td>
                                    <td>
                                        <p class="right"
                                            style="padding: 0; font-size: medium; font-weight: bold; margin-top: 0; margin-bottom: 0;">
                                            <%= data.amountPaid.toFixed(2) %>
                                        </p>
                                    </td>
                                </tr>

                                <% if (data.oldBalance!==0 || data.newBalance !==0) { %>
                                    <tr>
                                        <td>
                                            <p class="left" style="font-size: medium; margin-top: 0; margin-bottom: 0;">
                                                Previous Balance</p>
                                        </td>
                                        <td>
                                            <p class="right"
                                                style="padding: 0; font-size: medium; font-weight: bold; margin-top: 0; margin-bottom: 0;">
                                                <%= data.oldBalance.toFixed(2) %>
                                            </p>
                                        </td>
                                    </tr>
                                    <tr>
                                        <td>
                                            <p class="left" style="font-size: medium; margin-top: 0; margin-bottom: 0;">
                                                New Balance</p>
                                        </td>
                                        <td>
                                            <p class="right"
                                                style="padding: 0; font-size: medium; font-weight: bold; margin-top: 0; margin-bottom: 0;">
                                                <%= data.newBalance.toFixed(2) %>
                                            </p>
                                        </td>
                                    </tr>
                                    <% } %>

            </table>

            <% }); %>
            <% if (allShopsData.showShopsTotal) { %>
                <h2 style="text-align: center;">All Shops Total</h2>
                <table style="width: 72mm;">
                    <tr>
                        <td class="left">
                            <p style="font-size: small; margin-top: 0; margin-bottom: 0;">Total Items</p>
                        </td>
                        <td>
                            <p class="right"
                                style="padding: 0; font-size: medium; font-weight: bold; margin-top: 0; margin-bottom: 0;">
                                <%= allShopsData.totalItems.toFixed(2) %>
                            </p>
                        </td>
                    </tr>
                    <tr>
                        <td class="left">
                            <p style="font-size: small; margin-top: 0; margin-bottom: 0;">Subtotal</p>
                        </td>
                        <td>
                            <p class="right"
                                style="padding: 0; font-size: medium; font-weight: bold; margin-top: 0; margin-bottom: 0;">
                                <%= allShopsData.subTotal.toFixed(2) %>
                            </p>
                        </td>
                    </tr>
                    <% if (allShopsData.discount !==0) { %>
                        <tr>
                            <td class="left">
                                <p style="font-size: small; margin-top: 0; margin-bottom: 0;">Cart Discount</p>
                            </td>
                            <td>
                                <p class="right"
                                    style="padding: 0; font-size: medium; font-weight: bold; margin-top: 0; margin-bottom: 0;">
                                    <%= allShopsData.discount.toFixed(2) %>
                                </p>
                            </td>
                        </tr>

                        <tr>
                            <td class="left">
                                <p style="font-size: small; margin-top: 0; margin-bottom: 0;">Total After Discount</p>
                            </td>
                            <td>
                                <p class="right"
                                    style="padding: 0; font-size: medium; font-weight: bold; margin-top: 0; margin-bottom: 0;">
                                    <%= allShopsData.totalAfterDiscount.toFixed(2) %>
                                </p>
                            </td>
                        </tr>
                        <% } %>
                            <% allShopsData.mainPayments.forEach(payment=> { %>
                                <tr>
                                    <td>
                                        <p style="margin-top: 0; font-size: small; margin-bottom: 0;" class="left">
                                            <%= payment.name %>
                                        </p>
                                    </td>
                                    <td>
                                        <p class="right" style="margin-top: 0; font-size: medium; margin-bottom: 0;">
                                            <%= payment.amount.toFixed(2) %>
                                        </p>
                                    </td>
                                </tr>
                                <% }); %>
                                    <tr>
                                        <td class="left">
                                            <p style="font-size: small; margin-top: 0; margin-bottom: 0;">Paid Amount
                                            </p>
                                        </td>
                                        <td>
                                            <p class="right"
                                                style="padding: 0; font-size: medium; font-weight: bold; margin-top: 0; margin-bottom: 0;">
                                                <%= allShopsData.paidAmount.toFixed(2) %>
                                            </p>
                                        </td>
                                    </tr>
                                    <% if (allShopsData.customerBalance && allShopsData.customerBalance !==0) { %>
                                        <tr>
                                            <td style="margin-bottom: 0;" class="left">
                                                <p style="font-size: small;">Previous Balance</p>
                                            </td>
                                            <td>
                                                <p class="right"
                                                    style="padding: 0; font-size: medium; margin-bottom: 0; font-weight: bold;">
                                                    <%= allShopsData.customerBalance.toFixed(2) %>
                                                </p>
                                            </td>
                                        </tr>
                                        <tr>
                                            <td class="left">
                                                <p style="margin-bottom: 0; font-size: small; margin-top: 0;">Current Balance</p>
                                            </td>
                                            <td>
                                                <p class="right" style="margin-top: 0; font-size: medium; margin-bottom: 0;">
                                                    <%= allShopsData.customerNewBalance.toFixed(2) %>
                                                </p>
                                            </td>
                                        </tr>
                                        <% } %>

                </table>
                <% } %>
        </div>
</body>

</html>