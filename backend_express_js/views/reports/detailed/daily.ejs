    <!-- Print Button -->
    <button class="print-button" onclick="triggerPrint()">Print</button>


    <script>
        function triggerPrint() {
            window.print();
        }

        // Function to display the current date and time
        function displayDateTime() {
            var now = new Date();

            // Format the date
            var date = now.toLocaleDateString();

            // Format the time in 12-hour format
            var options = { hour: '2-digit', minute: '2-digit', second: '2-digit', hour12: true };
            var time = now.toLocaleTimeString([], options);

            // Update the content of the dateTime element with the formatted date and time
            document.getElementById('dateTime').textContent = date + " at " + time;
        }

        // Call the function to display the date and time when the page loads
        window.onload = displayDateTime;
    </script>


