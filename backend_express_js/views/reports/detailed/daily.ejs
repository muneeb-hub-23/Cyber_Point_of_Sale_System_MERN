<!DOCTYPE html>
<html lang="en">

<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Detailed Periodic Report</title>
    <style>
        body {
            font-family: Arial, sans-serif;
            background-color: white;
            color: black;
            margin: 0;
            padding: 0;
        }

        .container {
            width: 80%;
            margin: 30px auto;
            padding: 20px;
            border-radius: 8px;
            box-shadow: 0 4px 8px rgba(0, 0, 0, 0.1);
        }

        h1 {
            text-align: center;
            color: #3c3c3c;
            margin-bottom: 20px;
        }

        table {
            width: 90%;
            border-collapse: collapse;
            margin-top: 20px;
            margin-left: auto;
            margin-right: auto;
        }

        table th,
        table td {
            padding: 5px;
            text-align: center;
            border: 1px solid #ddd;
        }
        .print-button {
            display: block;
            width: 150px;
        
            margin: 20px auto;
            border: none;
            border-radius: 5px;
            font-size: 16px;
            cursor: pointer;
        }

        .print-button:focus {
            outline: none;
        }

        @media print {
            body {
                margin: 0;
                padding: 0;
            }

            .container {
                width: 100%;
            
                box-shadow: none;
            }

            table th,
            table td {
                font-size: 14px;
                padding: 5px;
            }
            h1{
                font-size: large;
            }
            .print-button {
                display: none;
            }
        }
    </style>
</head>

<body>

    <div class="container">
        <div class="report-header" id="reportHeader">
            Report Generated on: <span id="dateTime"></span>
        </div>

        <h1>Detailed Periodic Report From <%= titledate %> To <%= enddate %>
        </h1>

        <table>
            <thead>
                <tr>
                    <th>Shop Names</th>
                    <% shops.forEach(function(shop) { %>
                        <th>
                            <%= shop.name %>
                        </th>
                        <% }); %>
                            <th>Total Amount</th>
                </tr>
            </thead>
            <tbody>

                <tr>
                    <td style="text-align: left;">Stock Cost Amount</td>
                    <% let totalCost=0; %>
                        <% stock.forEach(function(st) { %>
                            <td>
                                <%= st.stockCost.toFixed(2) %>
                            </td>
                            <% totalCost +=st.stockCost; %>
                                <% }); %>
                                    <td>
                                        <%= totalCost.toFixed(2) %>
                                    </td>
                </tr>
                <tr style="font-weight: bold;">
                    <td style="text-align: left;">Amount (Sale - Cost)</td>
                    <% let totalDiff=0; %>
                        <% stock.forEach(function(st) { %>
                            <td>
                                <%= (st.stockSale - st.stockCost).toFixed(2) %>
                            </td>
                            <% totalDiff +=(st.stockSale - st.stockCost); %>
                                <% }); %>
                                    <td>
                                        <%= totalDiff.toFixed(2) %>
                                    </td>
                </tr>
                <tr>
                    <td style="text-align: left;">Average Profit (%)</td>
                    <% let totalMargin=0; %>
                        <% stock.forEach(function(st) { %>
                            <td>
                                <%= ((st.stockSale - st.stockCost) / st.stockCost * 100).toFixed(2) %>
                            </td>
                            <% totalMargin +=((st.stockSale - st.stockCost) / st.stockCost * 100); %>
                                <% }); %>
                                    <td>
                                        <%= (totalMargin / stock.length).toFixed(2) %>
                                    </td> <!-- Average profit margin -->
                </tr>
                <tr style="font-weight: bold;">
                    <td style="text-align: left;">Stock Sale Amount</td>
                    <% let totalSale=0; %>
                        <% stock.forEach(function(st) { %>
                            <td style="text-align: center;">
                                <%= st.stockSale.toFixed(2) %>
                            </td>
                            <% totalSale +=st.stockSale; %>
                                <% }); %>
